{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result-v3.schema.json",
  "title": "DGX Spark dual-QSFP accepted measurement result v3",
  "description": "Strict publication schema for a schema_version 3 measurement accepted after healthy preflight/postflight checks and a complete zero link-error delta. Standard-profile performance qualification is recorded independently and may be qualified, ineligible, below the floor, or missing required qualification evidence.",
  "$comment": "Consumers must additionally enforce completed_trials equals planned_trials and the schedule/trial/summary cardinalities implied by parameters; Draft 2020-12 cannot compare arbitrary instance properties.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_version",
    "pair_label",
    "config_fingerprint_sha256",
    "implementation_fingerprint_sha256",
    "started_at",
    "finished_at",
    "trials_complete",
    "measurement_accepted",
    "run_status",
    "completed_trials",
    "planned_trials",
    "metric",
    "units",
    "pcie_gen5_x4_raw_gbps_per_domain",
    "two_domain_raw_ceiling_gbps",
    "metadata",
    "validation",
    "parameters",
    "schedule_plan",
    "trials",
    "summaries",
    "qualification"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "suite_version": { "$ref": "result-v1.schema.json#/$defs/suiteVersion" },
    "pair_label": { "$ref": "result-v1.schema.json#/$defs/publicLabel" },
    "config_fingerprint_sha256": { "$ref": "result-v1.schema.json#/$defs/sha256" },
    "implementation_fingerprint_sha256": { "$ref": "result-v1.schema.json#/$defs/sha256" },
    "started_at": { "$ref": "result-v1.schema.json#/$defs/timestamp" },
    "finished_at": { "$ref": "result-v1.schema.json#/$defs/timestamp" },
    "trials_complete": { "const": true },
    "measurement_accepted": { "const": true },
    "run_status": { "const": "measurement-accepted" },
    "completed_trials": { "$ref": "result-v1.schema.json#/$defs/positiveInteger" },
    "planned_trials": { "$ref": "result-v1.schema.json#/$defs/positiveInteger" },
    "metric": { "const": "unidirectional host-memory RDMA write payload bandwidth" },
    "units": { "const": "Gbit/s (decimal)" },
    "pcie_gen5_x4_raw_gbps_per_domain": { "const": 126.030769 },
    "two_domain_raw_ceiling_gbps": { "const": 252.061538 },
    "metadata": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "result-v1.schema.json#/$defs/nodeMetadata" }
    },
    "validation": { "$ref": "result-v2.schema.json#/$defs/acceptedValidation" },
    "parameters": { "$ref": "result-v2.schema.json#/$defs/parametersV2" },
    "schedule_plan": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "result-v2.schema.json#/$defs/scheduleEntry" }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "result-v1.schema.json#/$defs/trial" }
    },
    "summaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "result-v1.schema.json#/$defs/summary" }
    },
    "qualification": {
      "oneOf": [
        { "$ref": "#/$defs/qualifiedQualification" },
        { "$ref": "#/$defs/ineligibleQualification" },
        { "$ref": "#/$defs/belowFloorQualification" },
        { "$ref": "#/$defs/insufficientObservationQualification" },
        { "$ref": "#/$defs/incompleteEvidenceQualification" }
      ]
    }
  },
  "$defs": {
    "qualificationCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "direction",
        "qps",
        "message_size_bytes",
        "tx_depth",
        "minimum_duration_seconds",
        "minimum_repeats",
        "minimum_cooldown_seconds",
        "schedule",
        "minimum_median_aggregate_gbps",
        "measurement_must_be_accepted",
        "preflight_must_be_healthy",
        "link_error_counter_delta_must_be_zero",
        "cpu_pinning_must_be_distinct"
      ],
      "properties": {
        "mode": { "const": "diagonal-a" },
        "direction": { "const": "worker-to-head" },
        "qps": { "const": 2 },
        "message_size_bytes": { "const": 65536 },
        "tx_depth": { "const": 128 },
        "minimum_duration_seconds": { "const": 30 },
        "minimum_repeats": { "const": 5 },
        "minimum_cooldown_seconds": { "const": 5.0 },
        "schedule": { "const": "interleaved" },
        "minimum_median_aggregate_gbps": { "const": 215.0 },
        "measurement_must_be_accepted": { "const": true },
        "preflight_must_be_healthy": { "const": true },
        "link_error_counter_delta_must_be_zero": { "const": true },
        "cpu_pinning_must_be_distinct": { "const": true }
      }
    },
    "genericObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median_aggregate_gbps", "trial_count", "cpu_pinning_verified"],
      "properties": {
        "median_aggregate_gbps": { "type": ["number", "null"], "minimum": 0 },
        "trial_count": { "type": "integer", "minimum": 0 },
        "cpu_pinning_verified": { "type": "boolean" }
      }
    },
    "qualifiedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median_aggregate_gbps", "trial_count", "cpu_pinning_verified"],
      "properties": {
        "median_aggregate_gbps": { "type": "number", "minimum": 215.0 },
        "trial_count": { "type": "integer", "minimum": 5 },
        "cpu_pinning_verified": { "const": true }
      }
    },
    "belowFloorObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median_aggregate_gbps", "trial_count", "cpu_pinning_verified"],
      "properties": {
        "median_aggregate_gbps": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 215.0
        },
        "trial_count": { "type": "integer", "minimum": 5 },
        "cpu_pinning_verified": { "const": true }
      }
    },
    "incompleteEvidenceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median_aggregate_gbps", "trial_count", "cpu_pinning_verified"],
      "properties": {
        "median_aggregate_gbps": { "type": "number", "minimum": 0 },
        "trial_count": { "type": "integer", "minimum": 5 },
        "cpu_pinning_verified": { "const": false }
      }
    },
    "eligibilityReason": {
      "enum": [
        "mode-set-mismatch",
        "direction-set-mismatch",
        "qps-set-mismatch",
        "message-size-set-mismatch",
        "tx-depth-set-mismatch",
        "duration-below-minimum",
        "repeats-below-minimum",
        "cooldown-below-minimum",
        "schedule-mismatch",
        "preflight-not-healthy"
      ]
    },
    "qualifiedQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "eligible",
        "qualified",
        "status",
        "reasons",
        "criteria",
        "observed"
      ],
      "properties": {
        "profile_id": { "const": "dgx-spark-dual-qsfp-standard" },
        "profile_version": { "const": 1 },
        "eligible": { "const": true },
        "qualified": { "const": true },
        "status": { "const": "qualified" },
        "reasons": { "type": "array", "maxItems": 0 },
        "criteria": { "$ref": "#/$defs/qualificationCriteria" },
        "observed": { "$ref": "#/$defs/qualifiedObservation" }
      }
    },
    "ineligibleQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "eligible",
        "qualified",
        "status",
        "reasons",
        "criteria",
        "observed"
      ],
      "properties": {
        "profile_id": { "const": "dgx-spark-dual-qsfp-standard" },
        "profile_version": { "const": 1 },
        "eligible": { "const": false },
        "qualified": { "const": false },
        "status": { "const": "ineligible" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/eligibilityReason" }
        },
        "criteria": { "$ref": "#/$defs/qualificationCriteria" },
        "observed": { "$ref": "#/$defs/genericObservation" }
      }
    },
    "belowFloorQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "eligible",
        "qualified",
        "status",
        "reasons",
        "criteria",
        "observed"
      ],
      "properties": {
        "profile_id": { "const": "dgx-spark-dual-qsfp-standard" },
        "profile_version": { "const": 1 },
        "eligible": { "const": true },
        "qualified": { "const": false },
        "status": { "const": "below-performance-floor" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "const": "median-below-minimum" }],
          "items": false
        },
        "criteria": { "$ref": "#/$defs/qualificationCriteria" },
        "observed": { "$ref": "#/$defs/belowFloorObservation" }
      }
    },
    "insufficientObservationQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "eligible",
        "qualified",
        "status",
        "reasons",
        "criteria",
        "observed"
      ],
      "properties": {
        "profile_id": { "const": "dgx-spark-dual-qsfp-standard" },
        "profile_version": { "const": 1 },
        "eligible": { "const": true },
        "qualified": { "const": false },
        "status": { "const": "insufficient-observations" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "const": "standard-profile-observation-incomplete" }],
          "items": false
        },
        "criteria": { "$ref": "#/$defs/qualificationCriteria" },
        "observed": { "$ref": "#/$defs/genericObservation" }
      }
    },
    "incompleteEvidenceQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "eligible",
        "qualified",
        "status",
        "reasons",
        "criteria",
        "observed"
      ],
      "properties": {
        "profile_id": { "const": "dgx-spark-dual-qsfp-standard" },
        "profile_version": { "const": 1 },
        "eligible": { "const": true },
        "qualified": { "const": false },
        "status": { "const": "qualification-evidence-incomplete" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "const": "cpu-pinning-not-demonstrated" }],
          "items": false
        },
        "criteria": { "$ref": "#/$defs/qualificationCriteria" },
        "observed": { "$ref": "#/$defs/incompleteEvidenceObservation" }
      }
    }
  }
}
